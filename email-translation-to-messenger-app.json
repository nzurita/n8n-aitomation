{
  "name": "Email Translation to Slack (local)",
  "nodes": [
    {
      "parameters": { "options": { "trackLastMessageId": false } },
      "name": "Email Trigger (IMAP)",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.2,
      "position": [0, 0],
      "credentials": { "imap": { "id": "PuKFQ3shgwTVFnqB", "name": "IMAP account" } }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Translate the following email to English. Return only the translated subject and body, no commentary. Skip headers, signature and legal text.\n\nSubject: {{ $json.subject }}\n\nBody:\n{{ $json.textPlain || $json.textHtml }}",
        "options": {
          "systemMessage": "You are a professional translator. Translate the user-provided email content into fluent, natural English. If the text is already in English, return it unchanged. Output only the translated text with no extra explanation."
        }
      },
      "name": "Translate to English",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [240, 0]
    },
    {
      "parameters": {
        "model": "qwen2.5-coder:14b",
        "options": { "temperature": 0.2 }
      },
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [240, 240]
    },
    {
      "parameters": {
        "select": "user",
        "user": { "__rl": true, "value": "U0C42RXFWFP", "mode": "id" },
        "text": "=*Translated email {{ $now.toFormat(\"dd/MM/yyyy HH:mm\") }}*\nFrom: {{ $(\"Email Trigger (IMAP)\").item.json.from }}\nSubject: {{ $(\"Email Trigger (IMAP)\").item.json.subject }}\n\n{{ $json.output }}",
        "otherOptions": {}
      },
      "name": "Send Translation to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [560, 0],
      "credentials": { "slackApi": { "id": "UFwAOJnqxEuAbWKt", "name": "Slack account" } }
    }
  ],
  "connections": {
    "Email Trigger (IMAP)": {
      "main": [[{ "node": "Translate to English", "type": "main", "index": 0 }]]
    },
    "Ollama Chat Model": {
      "ai_languageModel": [[{ "node": "Translate to English", "type": "ai_languageModel", "index": 0 }]]
    },
    "Translate to English": {
      "main": [[{ "node": "Send Translation to Slack", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}